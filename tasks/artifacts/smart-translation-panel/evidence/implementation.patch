index 0000000..cce1f9c
--- /dev/null
+++ b/Sources/UI/SmartTranslationPanel/SmartTranslationPanelController.swift
@@ -0,0 +1,229 @@
+import AppKit
+import SwiftUI
+
+/// 智能模式使用解析面板的窗口交互，独立拥有请求、回填目标与生命周期。
+@MainActor
+final class SmartTranslationPanelController: NSObject, NSWindowDelegate {
+    private static let preferredWidth: CGFloat = 560
+    private let coordinator: SmartTranslationCoordinator
+    private var panel: ParsingPanel?
+    private var keyMonitor: Any?
+    private var previouslyActiveApp: NSRunningApplication?
+    private var preferredContentHeight = ParsingPanelView.collapsedHeight
+    private var isResizeScheduled = false
+    private var focusGeneration = 0
+    private var pasteTarget: Result<ParsingPasteTarget, ParsingPasteError> = .failure(.noTarget)
+    private var pasteTask: Task<Void, Never>?
+    private let pasteErrorToast = ToastController()
+
+    init(coordinator: SmartTranslationCoordinator) {
+        self.coordinator = coordinator
+        super.init()
+        NotificationCenter.default.addObserver(self, selector: #selector(screenParametersDidChange), name: NSApplication.didChangeScreenParametersNotification, object: nil)
+        NotificationCenter.default.addObserver(self, selector: #selector(applicationDidResignActive), name: NSApplication.didResignActiveNotification, object: NSApp)
+    }
+
+    deinit {
+        NotificationCenter.default.removeObserver(self)
+    }
+
+    /// 重复打开只激活已有浮窗，不清空草稿或结果。
+    func show() {
+        pasteTask?.cancel()
+        pasteTask = nil
+        pasteErrorToast.dismiss()
+        focusGeneration += 1
+        if panel == nil {
+            pasteTarget = ParsingPasteTarget.capture()
+            let activeApp = NSWorkspace.shared.frontmostApplication
+            previouslyActiveApp = activeApp?.processIdentifier == ProcessInfo.processInfo.processIdentifier ? nil : activeApp
+            coordinator.reset()
+            preferredContentHeight = ParsingPanelView.collapsedHeight
+            let screen = NSScreen.screens.first { $0.frame.contains(NSEvent.mouseLocation) } ?? NSScreen.main
+            let width = min(Self.preferredWidth, max(1, (screen?.visibleFrame.width ?? Self.preferredWidth + 24) - 24))
+            let panel = ParsingPanel(
+                contentRect: NSRect(x: 0, y: 0, width: width, height: preferredContentHeight),
+                styleMask: [.borderless, .closable, .nonactivatingPanel],
+                backing: .buffered,
+                defer: false
+            )
+            panel.title = String(localized: "Smart Translation")
+            panel.level = .floating
+            panel.isFloatingPanel = true
+            panel.hidesOnDeactivate = false
+            panel.isReleasedWhenClosed = false
+            panel.isOpaque = false
+            panel.backgroundColor = .clear
+            panel.hasShadow = true
+            panel.isMovableByWindowBackground = false
+            panel.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
+            panel.delegate = self
+            panel.onCancel = { [weak self] in
+                guard let self else { return }
+                self.dismiss()
+            }
+            self.panel = panel
+            let content = SmartTranslationPanelView(
+                coordinator: coordinator,
+                onContentHeightChange: { [weak self, weak panel] height in
+                    guard let self, let panel, self.panel === panel else { return }
+                    self.requestResize(to: height)
+                },
+                onPasteResult: { [weak self, weak panel] text in
+                    guard let self, let panel, self.panel === panel else { return }
+                    self.pasteResult(text)
+                }
+            )
+            let hostingView = NSHostingView(rootView: content)
+            hostingView.sizingOptions = []
+            panel.contentView = hostingView
+            if let frame = screen?.visibleFrame {
+                panel.setFrameOrigin(NSPoint(x: frame.midX - panel.frame.width / 2, y: frame.midY - panel.frame.height / 2))
+            } else {
+                panel.center()
+            }
+            startKeyMonitor()
+        }
+        NSApp.activate(ignoringOtherApps: true)
+        panel?.makeKeyAndOrderFront(nil)
+    }
+
+    /// 仅已完成句子可调用，目标捕获和回填验证复用原解析实现。
+    private func pasteResult(_ text: String) {
+        guard pasteTask == nil else { return }
+        do {
+            let target = try pasteTarget.get()
+            try target.validateBeforeHandoff()
+            let generation = focusGeneration
+            dismiss(restoringFocus: false)
+            pasteTask = Task { @MainActor [weak self] in
+                defer {
+                    if self?.focusGeneration == generation { self?.pasteTask = nil }
+                }
+                do {
+                    try await target.paste(text)
+                } catch is CancellationError {
+                    // 新的打开或关闭操作已取代这次回填。
+                } catch {
+                    guard let self, !Task.isCancelled, self.focusGeneration == generation else { return }
+                    self.pasteErrorToast.show(message: error.localizedDescription, duration: 4)
+                }
+            }
+        } catch {
+            coordinator.showPasteFailure(error.localizedDescription)
+        }
+    }
+
+    func windowShouldClose(_ sender: NSWindow) -> Bool {
+        dismiss()
+        return false
+    }
+
+    func windowDidChangeScreen(_ notification: Notification) {
+        requestResize(to: preferredContentHeight)
+    }
+
+    func windowDidResignKey(_ notification: Notification) {
+        guard let window = notification.object as? NSWindow, window === panel else { return }
+        dismissAfterFocusChange(applicationDeactivated: false)
+    }
+
+    @objc
+    private func applicationDidResignActive() {
+        dismissAfterFocusChange(applicationDeactivated: true)
+    }
+
+    private func dismissAfterFocusChange(applicationDeactivated: Bool) {
+        guard let panel else { return }
+        let generation = focusGeneration
+        DispatchQueue.main.async { [weak self, weak panel] in
+            guard let self, let panel, self.panel === panel, self.focusGeneration == generation else { return }
+            let lostFocus = applicationDeactivated ? !NSApp.isActive : !panel.isKeyWindow
+            guard lostFocus else { return }
+            self.dismiss(restoringFocus: false)
+        }
+    }
+
+    /// 清理本模式的窗口和请求，不改变其它模式；关闭前显式释放 contentView。
+    func dismiss(restoringFocus: Bool = true) {
+        pasteTask?.cancel()
+        pasteTask = nil
+        pasteTarget = .failure(.noTarget)
+        let shouldRestoreFocus = restoringFocus && NSApp.isActive && panel?.isKeyWindow == true
+        if let keyMonitor { NSEvent.removeMonitor(keyMonitor) }
+        keyMonitor = nil
+        coordinator.reset()
+        preferredContentHeight = ParsingPanelView.collapsedHeight
+        panel?.contentView = nil
+        panel?.onCancel = nil
+        panel?.delegate = nil
+        panel?.close()
+        panel = nil
+        if shouldRestoreFocus { previouslyActiveApp?.activate(options: []) }
+        previouslyActiveApp = nil
+    }
+
+    private func requestResize(to height: CGFloat) {
+        guard panel != nil, height.isFinite, height > 0 else { return }
+        preferredContentHeight = height
+        guard !isResizeScheduled else { return }
+        isResizeScheduled = true
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.isResizeScheduled = false
+            self.resizeToContent()
+        }
+    }
+
+    private func resizeToContent() {
+        guard let panel, let visibleFrame = (panel.screen ?? NSScreen.main)?.visibleFrame else { return }
+        let bounds = visibleFrame.insetBy(dx: 12, dy: 12)
+        guard bounds.width > 0, bounds.height > 0 else { return }
+        var frame = panel.frame
+        let top = frame.maxY
+        frame.size.width = min(Self.preferredWidth, bounds.width)
+        frame.size.height = min(max(ParsingPanelView.collapsedHeight, ceil(preferredContentHeight)), min(640, bounds.height))
+        frame.origin.y = top - frame.height
+        frame.origin.x = min(max(frame.minX, bounds.minX), bounds.maxX - frame.width)
+        frame.origin.y = min(max(frame.minY, bounds.minY), bounds.maxY - frame.height)
+        if frame != panel.frame { panel.setFrame(frame, display: true) }
+    }
+
+    @objc
+    private func screenParametersDidChange() {
+        requestResize(to: preferredContentHeight)
+    }
+
+    /// 保留旧单词模式的显式复制快捷键，且只消费此窗口的键盘事件。
+    private func startKeyMonitor() {
+        keyMonitor = NSEvent.addLocalMonitorForEvents(matching: .keyDown) { [weak self] event in
+            guard let self, let panel = self.panel, panel.isKeyWindow, event.window === panel else { return event }
+            if (panel.firstResponder as? NSTextView)?.hasMarkedText() == true { return event }
+            let modifiers = event.modifierFlags.intersection([.command, .option, .control, .shift])
+            guard modifiers == .command else { return event }
+            if event.keyCode == 36 || event.keyCode == 76 {
+                let result = self.coordinator.activeSlots.lazy.compactMap { provider -> SmartTranslationResult? in
+                    if case let .completed(result) = self.coordinator.providerStates[provider.id] { return result }
+                    return nil
+                }.first
+                if let result { self.copyAndDismiss(result) }
+                return nil
+            }
+            if let characters = event.charactersIgnoringModifiers, let number = Int(characters), (1...9).contains(number) {
+                let slots = self.coordinator.activeSlots
+                if slots.indices.contains(number - 1),
+                   case let .completed(result) = self.coordinator.providerStates[slots[number - 1].id] {
+                    self.copyAndDismiss(result)
+                }
+                return nil
+            }
+            return event
+        }
+    }
+
+    private func copyAndDismiss(_ result: SmartTranslationResult) {
+        NSPasteboard.general.clearContents()
+        NSPasteboard.general.setString(result.plainText, forType: .string)
+        dismiss()
+    }
+}
diff --git a/Sources/UI/SmartTranslationPanel/SmartTranslationPanelView.swift b/Sources/UI/SmartTranslationPanel/SmartTranslationPanelView.swift
new file mode 100644
index 0000000..5661d65
--- /dev/null
+++ b/Sources/UI/SmartTranslationPanel/SmartTranslationPanelView.swift
@@ -0,0 +1,184 @@
+import AppKit
+import Defaults
+import SwiftUI
+
+/// 与解析面板共用输入区和句子结果，词条按已确认原型紧凑展开。
+struct SmartTranslationPanelView: View {
+    let coordinator: SmartTranslationCoordinator
+    let onContentHeightChange: (CGFloat) -> Void
+    let onPasteResult: (String) -> Void
+
+    @State private var draft = ""
+    @State private var resultsHeight: CGFloat = 0
+    @Default(.popupFontSize) private var fontSize
+    @Default(.popupFontName) private var fontName
+
+    private var inputText: Binding<String> {
+        Binding(
+            get: { draft },
+            set: { value in
+                guard value != draft else { return }
+                coordinator.reset()
+                draft = value
+            }
+        )
+    }
+
+    private var hasResults: Bool {
+        coordinator.globalError != nil || !coordinator.activeSlots.isEmpty
+    }
+
+    private var showsDivider: Bool {
+        !coordinator.providerStates.values.contains {
+            if case .completed(.sentence(translation: .some, parsing: _)) = $0 { return true }
+            return false
+        }
+    }
+
+    private var preferredHeight: CGFloat {
+        ParsingPanelView.collapsedHeight + (hasResults ? (showsDivider ? 21 : 10) + max(24, resultsHeight) : 0)
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            ParsingTextEditor(
+                text: inputText,
+                font: .popup(name: fontName, size: CGFloat(fontSize)),
+                onSubmit: submit,
+                placeholder: String(localized: "Type or paste a word or sentence, then press Return."),
+                accessibilityLabel: String(localized: "Text for smart translation")
+            )
+            .frame(height: ParsingPanelView.inputHeight)
+
+            if hasResults {
+                if showsDivider { Divider() }
+                ScrollView {
+                    results
+                        .frame(maxWidth: .infinity, alignment: .leading)
+                        .fixedSize(horizontal: false, vertical: true)
+                        .background {
+                            GeometryReader { geometry in
+                                Color.clear.preference(key: ParsingResultsHeightKey.self, value: geometry.size.height)
+                            }
+                            .allowsHitTesting(false)
+                        }
+                }
+            }
+        }
+        .padding(ParsingPanelView.contentPadding)
+        .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .top)
+        .background(.regularMaterial, in: RoundedRectangle(cornerRadius: 12))
+        .onPreferenceChange(ParsingResultsHeightKey.self) { height in
+            guard height.isFinite else { return }
+            resultsHeight = max(0, ceil(height))
+        }
+        .onChange(of: hasResults) { _, visible in
+            if !visible { resultsHeight = 0 }
+        }
+        .onChange(of: preferredHeight) { _, height in onContentHeightChange(height) }
+        .onAppear { onContentHeightChange(preferredHeight) }
+    }
+
+    private func submit() {
+        switch coordinator.enterAction(for: draft) {
+        case .process:
+            resultsHeight = 0
+            coordinator.process(draft)
+        case .wait: break
+        case let .paste(text): onPasteResult(text)
+        case .noContent: coordinator.showPasteFailure(String(localized: "No English text to paste."))
+        }
+    }
+
+    private var results: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            if let error = coordinator.globalError { Text(error).foregroundStyle(.red) }
+            if let error = coordinator.historyError { Text(error).foregroundStyle(.red) }
+            ForEach(coordinator.activeSlots, id: \.id) { provider in
+                if let state = coordinator.providerStates[provider.id] {
+                    VStack(alignment: .leading, spacing: 4) {
+                        if coordinator.activeSlots.count > 1 {
+                            Text(provider.displayName).font(.caption).foregroundStyle(.secondary)
+                        }
+                        switch state {
+                        case .loading:
+                            Text("Translating and analyzing…").foregroundStyle(.secondary)
+                        case let .error(message):
+                            Text(message).foregroundStyle(.red)
+                        case let .completed(result):
+                            resultView(result)
+                                .textSelection(.enabled)
+                                .contextMenu {
+                                    Button("Copy") {
+                                        NSPasteboard.general.clearContents()
+                                        NSPasteboard.general.setString(result.plainText, forType: .string)
+                                    }
+                                }
+                        }
+                    }
+                }
+            }
+        }
+        .font(.system(size: CGFloat(fontSize), design: .monospaced))
+    }
+
+    @ViewBuilder
+    private func resultView(_ result: SmartTranslationResult) -> some View {
+        switch result {
+        case let .words(entries):
+            VStack(alignment: .leading, spacing: 8) {
+                ForEach(Array(entries.enumerated()), id: \.offset) { index, entry in
+                    if index > 0 { Divider() }
+                    SmartDictionaryEntryView(entry: entry, fontSize: CGFloat(fontSize), fontName: fontName)
+                }
+            }
+        case let .sentence(translation, parsing):
+            VStack(alignment: .leading, spacing: 5) {
+                if let translation {
+                    Text(verbatim: translation).foregroundStyle(.secondary)
+                } else if coordinator.globalError == nil, case .paste = coordinator.enterAction(for: draft) {
+                    Text("Press Return again to paste the English result back.")
+                        .font(.caption)
+                        .foregroundStyle(.secondary)
+                }
+                StyledParsingResultView(result: parsing)
+            }
+        case .skip:
+            Text(result.plainText).foregroundStyle(.secondary)
+        }
+    }
+}
+
+private struct SmartDictionaryEntryView: View {
+    let entry: SmartTranslationResult.Entry
+    let fontSize: CGFloat
+    let fontName: String
+    @Environment(\.colorScheme) private var colorScheme
+
+    private var accent: Color {
+        colorScheme == .dark ? .teal : Color(red: 0, green: 0.40, blue: 0.45)
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 3) {
+            // 一个 Text 保留窄窗口和长词条的自然换行，不让音标挤压标题。
+            (Text(verbatim: entry.word).font(.popup(name: fontName, size: fontSize + 3)).fontWeight(.semibold)
+                + Text(verbatim: "  " + entry.phonetic).foregroundColor(.secondary))
+            ForEach(Array(entry.meanings.enumerated()), id: \.offset) { _, meaning in
+                Text(verbatim: meaning.partOfSpeech).foregroundColor(accent)
+                    + Text(verbatim: "  " + meaning.definition)
+            }
+            if let usage = entry.usage, !usage.isEmpty {
+                Text(verbatim: usage).foregroundStyle(.secondary)
+            }
+            ForEach(Array(entry.examples.enumerated()), id: \.offset) { index, example in
+                VStack(alignment: .leading, spacing: 0) {
+                    Text(verbatim: "\(index + 1). \(example.sentence)")
+                    Text(verbatim: example.translation).foregroundStyle(.secondary)
+                }
+                .padding(.top, 1)
+            }
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+    }
+}
