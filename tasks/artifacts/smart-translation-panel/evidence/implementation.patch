+<section class="section"><div class="word-line"><span class="word">persistence</span><span class="phonetic">/pərˈsɪstəns/</span></div><p class="definitions"><span class="term">名词</span>　坚持不懈；持续努力</p><p class="explanation">强调遇到困难仍继续做某件事。</p><div class="example">1. Her persistence finally paid off.<p class="explanation">她的坚持终于得到了回报。</p></div><div class="example">2. Learning a language takes persistence.<p class="explanation">学习语言需要坚持不懈。</p></div><div class="example">3. He showed great persistence in solving the problem.<p class="explanation">他在解决这个问题时表现出了极大的毅力。</p></div></section>
+<section class="section"><div class="word-line"><span class="word">tenacity</span><span class="phonetic">/təˈnæsəti/</span></div><p class="definitions"><span class="term">名词</span>　坚韧；顽强；执着</p><p class="explanation">比 persistence 更突出顽强、紧抓目标不放的意志。</p><div class="example">1. I admire her tenacity.<p class="explanation">我钦佩她的坚韧。</p></div><div class="example">2. The team fought back with remarkable tenacity.<p class="explanation">这支队伍以非凡的韧劲奋起反击。</p></div><div class="example">3. His tenacity helped him overcome repeated setbacks.<p class="explanation">他的顽强帮助他克服了一次次挫折。</p></div></section>
+</template>
+<template id="en-sentence">
+<section class="section translation" aria-label="中文翻译"><p>她昨天不太了解这个问题。</p></section>
+<section class="section"><div class="result-header">写作检查</div><p><span class="wrong">don't understood</span> → <span class="right">didn't understand</span></p><p class="explanation">yesterday 表示过去时间，否定句用 didn't，后接动词原形 understand。</p></section>
+</template>
+<template id="zh-sentence">
+<p class="paste-note">再次按回车，将英文正文粘贴回原输入框。</p>
+<section class="section"><div class="result-header" lang="en">Writing tutor</div><p class="sentence">◇ Could you explain why this approach is more reliable?</p><div class="subheading" lang="en">Words</div><p class="annotation"><span class="term">approach</span>　<span class="explanation">解决问题的方法或思路；这里比强调具体操作步骤的 method 更自然。</span></p><p class="annotation"><span class="term">reliable</span>　<span class="explanation">可靠、值得信赖；强调方法能稳定得到预期结果。</span></p><div class="subheading" lang="en">Grammar</div><p class="annotation"><span class="term">Could you + 动词原形</span>　<span class="explanation">委婉地提出请求，比直接使用命令语气更礼貌。</span></p><p class="annotation"><span class="term">why 引导的宾语从句</span>　<span class="explanation">explain 后接说明原因的从句，使用陈述语序 this approach is。</span></p></section>
+</template>
+<script>
+'use strict';
+const examples = {
+  'en-word': {input:'resilient', title:'英文单词 → 字典结果', flow:['单词与音标','常见词性及中文释义','三组中英双语例句'], note:'延续现有单词翻译的内容结构，不增加句子解析。', decision:'英文单词保留完整字典结果，展示是否合适？'},
+  'zh-word': {input:'坚韧', title:'中文词语 → 两个候选', flow:['给出两个自然英文候选','说明候选之间的使用差异','每个候选分别展示音标、词性、释义和三组例句'], note:'本稿将“单词解析”理解为分别解析两个英文候选，采用上下排列，长内容在面板内滚动。', decision:'已确认：两个英文候选都完整展开，各自展示音标、词性、释义和三组双语例句；超出高度时在面板内滚动。'},
+  'en-sentence': {input:"She don't understood the issue very well yesterday.", title:'英文句子 → 翻译与现有解析', flow:['顶部显示中文翻译','紧接着显示现有 parsing 服务的结果','纠错、原因及可选自然改写均沿用 parsing；无修改时显示原有提示'], note:'已确认：翻译之后的内容与现有 parsing 服务一致。不增加词汇或句法讲解，不自行拼接修正后的完整英文。本例只有纠错，没有可选改写。', decision:'已确认：中文译文以淡色正文显示，不加标题或上下分隔线；现有 parsing 结果紧随其后。'},
+  'zh-sentence': {input:'你能解释一下为什么这个方案更可靠吗？', title:'中文句子 → 现有解析', flow:['一条自然英文表达','关键词的含义、用法与选择理由','英文语法结构及其使用原因'], note:'对应现有 tutor 模式：最多五项词汇、三项语法；说明语言沿用解析设置。示例采用中文说明。', decision:'已确认：直接复用现有 parsing 面板的结果展示，不新增翻译块、解释层或自定义分组。原型只模拟内容，不执行回填。'}
+};
+const input = document.querySelector('#input');
+const results = document.querySelector('#results');
+const notice = document.querySelector('#notice');
+let active = 'en-word';
+function setState(state) {
+  notice.textContent = '';
+  document.querySelectorAll('[data-state]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.state === state)));
+  results.replaceChildren();
+  results.hidden = state === 'empty';
+  results.setAttribute('aria-busy', String(state === 'loading'));
+  if (state === 'empty') { input.value = ''; return; }
+  input.value = examples[active].input;
+  if (state === 'result') {
+    results.append(document.getElementById(active).content.cloneNode(true));
+  } else if (state === 'loading') {
+    const line = document.createElement('div'); line.className = 'loading';
+    const spinner = document.createElement('span'); spinner.className = 'spinner'; spinner.setAttribute('aria-hidden','true');
+    line.append(spinner, document.createTextNode('正在识别并处理输入…')); results.append(line);
+  } else {
+    const text = document.createElement('p'); text.className = 'error'; text.textContent = '暂时无法取得结果。输入已保留，请重试。';
+    const retry = document.createElement('button'); retry.className = 'retry'; retry.textContent = '重试示例'; retry.onclick = () => setState('result'); results.append(text, retry);
+  }
+  results.scrollTop = 0;
+}
+function selectExample(key) {
+  active = key;
+  document.querySelectorAll('[data-case]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.case === key)));
+  const example = examples[key];
+  const title = document.createElement('h2'); title.textContent = example.title;
+  const flow = document.createElement('div'); flow.className = 'flow';
+  const list = document.createElement('ol');
+  example.flow.forEach(item => { const li = document.createElement('li'); li.textContent = item; list.append(li); });
+  flow.append(title,list);
+  const note = document.createElement('p'); note.className = 'muted'; note.textContent = example.note;
+  document.querySelector('#description').replaceChildren(flow,note);
+  document.querySelector('#decision').textContent = example.decision;
+  setState('result');
+}
+document.querySelectorAll('[data-case]').forEach(button => button.addEventListener('click', () => selectExample(button.dataset.case)));
+document.querySelectorAll('[data-state]').forEach(button => button.addEventListener('click', () => setState(button.dataset.state)));
+input.addEventListener('input', () => {
+  results.hidden = true; results.replaceChildren(); results.setAttribute('aria-busy','false');
+  document.querySelectorAll('[data-state]').forEach(button => button.setAttribute('aria-pressed','false'));
+  notice.textContent = input.value ? '示例输入已修改；按 Return 查看是否匹配预置示例。' : '';
+});
+input.addEventListener('keydown', event => {
+  if (event.isComposing || event.keyCode === 229) return;
+  if (event.key !== 'Enter' || event.shiftKey || event.metaKey || event.ctrlKey || event.altKey) return;
+  event.preventDefault();
+  if (event.repeat || !input.value.trim()) return;
+  const match = Object.keys(examples).find(key => examples[key].input === input.value.trim());
+  if (match) selectExample(match);
+  else notice.textContent = '这是展示原型，未接入翻译服务。请从左侧选择一个示例。';
+});
+document.querySelector('#theme').addEventListener('click', event => {
+  const dark = document.body.classList.toggle('dark');
+  event.currentTarget.textContent = dark ? '切换浅色' : '切换深色';
+  event.currentTarget.setAttribute('aria-pressed',String(dark));
+});
+selectExample('en-word');
+</script>
+</body>
