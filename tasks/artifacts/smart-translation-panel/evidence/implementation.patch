diff --git a/Sources/Core/SmartTranslationCoordinator.swift b/Sources/Core/SmartTranslationCoordinator.swift
new file mode 100644
index 0000000..d30f9a7
--- /dev/null
+++ b/Sources/Core/SmartTranslationCoordinator.swift
@@ -0,0 +1,222 @@
+import Defaults
+import Foundation
+import Observation
+
+/// 独立智能会话：语义路由后处理词条，或复用原解析协议处理句子。
+@MainActor
+@Observable
+final class SmartTranslationCoordinator {
+    enum ProviderState: Equatable {
+        /// 正在分类、查询或解析，不展示中间 JSON。
+        case loading
+        /// 完整且已验证的结果。
+        case completed(SmartTranslationResult)
+        /// 当前服务失败，可重新提交。
+        case error(String)
+    }
+
+    enum EnterAction {
+        /// 新输入或失败后的重试。
+        case process
+        /// 请求仍在执行，或词条已完成，无需重复请求。
+        case wait
+        /// 句子可按原解析规则回填英文。
+        case paste(String)
+        /// 仅有提示，没有英文正文。
+        case noContent
+    }
+
+    private(set) var activeSlots: [any TranslationProvider] = []
+    private(set) var providerStates: [String: ProviderState] = [:]
+    private(set) var globalError: String?
+    private(set) var historyError: String?
+    var selectedProviderID: String {
+        didSet {
+            guard selectedProviderID != oldValue else { return }
+            Defaults[.smartTranslationProviderID] = selectedProviderID
+            reset()
+        }
+    }
+
+    /// 智能模式要求同一服务支持路由和原有解析；复杂度 O(服务数)。
+    var availableProviders: [any TranslationProvider] {
+        registry.providers.filter { $0.supportsSmartTranslation && $0.supportsParsing }
+    }
+
+    private let registry: TranslationProviderRegistry
+    private let historyStore: ParsingHistoryStore
+    private var tasks: [String: Task<Void, Never>] = [:]
+    private var generation = 0
+    private var submittedText: String?
+
+    init(registry: TranslationProviderRegistry, historyStore: ParsingHistoryStore) {
+        self.registry = registry
+        self.historyStore = historyStore
+        selectedProviderID = Defaults[.smartTranslationProviderID]
+    }
+
+    /// 仅提交当前输入；每个服务独立返回一种完整结果，不修改普通翻译或解析会话。
+    func process(_ text: String) {
+        reset()
+        let text = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !text.isEmpty else {
+            globalError = String(localized: "Empty text")
+            return
+        }
+        submittedText = text
+        if selectedProviderID.isEmpty {
+            activeSlots = registry.enabledSlots.filter { $0.supportsSmartTranslation && $0.supportsParsing }
+        } else {
+            guard let provider = registry.provider(withID: selectedProviderID),
+                  provider.supportsSmartTranslation, provider.supportsParsing else {
+                globalError = String(localized: "Selected smart translation provider is unavailable. Choose another provider in Settings.")
+                return
+            }
+            activeSlots = registry.modelSlots(for: provider)
+        }
+        guard !activeSlots.isEmpty else {
+            globalError = String(localized: "Smart translation requires an LLM provider. Choose one in Settings.")
+            return
+        }
+        let source = LanguageDetector.detectWithConfidence(text, threshold: Defaults[.detectionConfidenceThreshold]).language
+        let language = Defaults[.parsingExplanationLanguage].isEmpty ? Defaults[.targetLanguage] : Defaults[.parsingExplanationLanguage]
+        let generation = generation
+        for provider in activeSlots {
+            let model: String?
+            if let slot = provider as? ModelSlotProvider {
+                model = slot.modelOverride
+            } else if let provider = provider as? any ParallelModelProvider {
+                model = Defaults[provider.modelKey]
+            } else {
+                model = nil
+            }
+            providerStates[provider.id] = .loading
+            tasks[provider.id] = Task { [weak self] in
+                guard let self else { return }
+                await self.run(provider, text: text, source: source, language: language, model: model, generation: generation)
+            }
+        }
+    }
+
+    /// 只对当前输入的已完成句子回填，词条保留原来的显式复制方式。
+    func enterAction(for text: String) -> EnterAction {
+        guard let submittedText, submittedText == text.trimmingCharacters(in: .whitespacesAndNewlines) else { return .process }
+        for provider in activeSlots {
+            if case let .completed(result) = providerStates[provider.id], let text = result.pasteText(for: submittedText) {
+                return .paste(text)
+            }
+        }
+        if providerStates.values.contains(where: {
+            if case .loading = $0 { return true }
+            if case .completed(.words) = $0 { return true }
+            return false
+        }) { return .wait }
+        if providerStates.values.contains(where: {
+            if case .completed = $0 { return true }
+            return false
+        }) { return .noContent }
+        return .process
+    }
+
+    func showPasteFailure(_ message: String) {
+        globalError = message
+    }
+
+    /// 关闭、编辑或切换服务时取消请求，隔离迟到的分类与解析结果。
+    func reset() {
+        generation += 1
+        for task in tasks.values { task.cancel() }
+        tasks.removeAll()
+        activeSlots = []
+        providerStates = [:]
+        globalError = nil
+        historyError = nil
+        submittedText = nil
+    }
+
+    private func run(
+        _ provider: any TranslationProvider,
+        text: String,
+        source: String?,
+        language: String,
+        model: String?,
+        generation: Int
+    ) async {
+        guard !Task.isCancelled, generation == self.generation else { return }
+        defer {
+            if generation == self.generation { tasks.removeValue(forKey: provider.id) }
+        }
+        do {
+            let response = try await collect(provider, text: text, source: source, language: language, mode: .smartTranslation, model: model)
+            guard !Task.isCancelled, generation == self.generation else { return }
+            guard let route = SmartTranslationRoute.decode(response) else { throw SmartTranslationError.invalidResult }
+            let result: SmartTranslationResult
+            switch route {
+            case let .englishWord(entry): result = .words([entry])
+            case let .chineseWord(entries): result = .words(entries)
+            case .skip: result = .skip
+            case .englishSentence, .chineseSentence:
+                let translation: String?
+                if case let .englishSentence(value) = route { translation = value } else { translation = nil }
+                let content = try await collect(provider, text: text, source: source, language: language, mode: .parsing, model: model)
+                guard !Task.isCancelled, generation == self.generation else { return }
+                guard let parsing = ParsingResult.decode(content) else { throw SmartTranslationError.invalidResult }
+                result = .sentence(translation: translation, parsing: parsing)
+                // 与现有解析相同：已完成的解析独立保存，关闭面板不取消落盘。
+                let completedAt = Date()
+                let providerName = provider.displayName
+                let providerID = provider.id
+                let save = Task { [historyStore] in
+                    try await historyStore.append(
+                        sourceText: text,
+                        result: parsing,
+                        providerName: providerName,
+                        providerID: providerID,
+                        model: model,
+                        date: completedAt
+                    )
+                }
+                do {
+                    _ = try await save.value
+                } catch {
+                    if !Task.isCancelled, generation == self.generation {
+                        historyError = String(localized: "Could not save parsing history. The result is still available; copy it before closing.")
+                    }
+                }
+            }
+            guard !Task.isCancelled, generation == self.generation else { return }
+            providerStates[provider.id] = .completed(result)
+        } catch {
+            guard !Task.isCancelled, generation == self.generation else { return }
+            providerStates[provider.id] = .error(error.localizedDescription)
+        }
+    }
+
+    /// 有界收集完整结果；消费取消会终止 Provider 的底层流任务。
+    private func collect(
+        _ provider: any TranslationProvider,
+        text: String,
+        source: String?,
+        language: String,
+        mode: TextProcessingMode,
+        model: String?
+    ) async throws -> String {
+        var content = ""
+        for try await chunk in provider.processStream(text, from: source, to: language, mode: mode, model: model) {
+            try Task.checkCancellation()
+            content += chunk
+            guard content.utf8.count <= 65_536 else { throw SmartTranslationError.invalidResult }
+        }
+        try Task.checkCancellation()
+        return content
+    }
+}
+
+private enum SmartTranslationError: LocalizedError {
+    /// 无效或超过大小限制的模型输出。
+    case invalidResult
+
+    var errorDescription: String? {
+        String(localized: "Smart translation returned an invalid result. Please try again.")
+    }
+}
diff --git a/Sources/Core/SmartTranslationResult.swift b/Sources/Core/SmartTranslationResult.swift
new file mode 100644
index 0000000..879b48b
--- /dev/null
+++ b/Sources/Core/SmartTranslationResult.swift
@@ -0,0 +1,126 @@
+import Foundation
+
+/// 智能模式的最终结果；句子部分保留原有 ParsingResult，不重写解析语义。
+enum SmartTranslationResult: Equatable, Sendable {
+    /// 一个英文词条，或两个中文词语的英文候选。
+    case words([Entry])
+    /// 可选中文译文后紧接原解析结果。
+    case sentence(translation: String?, parsing: ParsingResult)
+    /// 输入不适合词典或句子解析。
+    case skip
+
+    struct Entry: Decodable, Equatable, Sendable {
+        struct Meaning: Decodable, Equatable, Sendable {
+            let partOfSpeech: String
+            let definition: String
+        }
+
+        struct Example: Decodable, Equatable, Sendable {
+            let sentence: String
+            let translation: String
+        }
+
+        let word: String
+        let phonetic: String
+        let meanings: [Meaning]
+        let usage: String?
+        let examples: [Example]
+
+        /// 完整词条必须含词性、释义和三组非空双语例句；复杂度 O(字段总字符数)。
+        var isValid: Bool {
+            guard !meanings.isEmpty, examples.count == 3 else { return false }
+            let fields = [word, phonetic]
+                + meanings.flatMap { [$0.partOfSpeech, $0.definition] }
+                + examples.flatMap { [$0.sentence, $0.translation] }
+            return fields.allSatisfy { !$0.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty }
+        }
+
+        /// 与紧凑词条内容一致的复制文本；复杂度 O(词条字符数)。
+        var plainText: String {
+            var lines = ["\(word)  \(phonetic)"]
+            lines += meanings.map { "[\($0.partOfSpeech)] \($0.definition)" }
+            if let usage, !usage.isEmpty { lines.append(usage) }
+            lines += examples.enumerated().map { index, example in
+                "\(index + 1). \(example.sentence)\n\(example.translation)"
+            }
+            return lines.joined(separator: "\n")
+        }
+    }
+
+    /// 复制全部可见内容，不包含展示标签；复杂度 O(结果字符数)。
+    var plainText: String {
+        switch self {
+        case let .words(entries): entries.map(\.plainText).joined(separator: "\n\n")
+        case let .sentence(translation, parsing):
+            [translation, parsing.plainText].compactMap { $0 }.joined(separator: "\n\n")
+        case .skip: String(localized: "Enter an English or Chinese word or sentence to translate.")
+        }
+    }
+
+    /// 只有句子结果参与原有英文回填，词条通过复制操作取出。
+    func pasteText(for source: String) -> String? {
+        guard case let .sentence(_, parsing) = self else { return nil }
+        return parsing.pasteText(for: source)
+    }
+}
+
+/// 首次请求只分类并生成词典或中文译文；句子解析必须走原有 parsing 请求。
+enum SmartTranslationRoute: Decodable {
+    /// 单个英文词条或词典短语。
+    case englishWord(SmartTranslationResult.Entry)
+    /// 两个不同的英文候选，均有用法说明。
+    case chineseWord([SmartTranslationResult.Entry])
+    /// 英文句子的中文译文，后续仍需解析原英文输入。
+    case englishSentence(String)
+    /// 中文句子，后续直接采用原解析服务。
+    case chineseSentence
+    /// 不支持的语言、代码或无法分析的输入。
+    case skip
+
+    private enum CodingKeys: String, CodingKey {
+        case mode, entry, candidates, translation
+    }
+
+    init(from decoder: any Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        switch try container.decode(String.self, forKey: .mode) {
+        case "englishWord":
+            let entry = try container.decode(SmartTranslationResult.Entry.self, forKey: .entry)
+            guard entry.isValid else {
+                throw DecodingError.dataCorruptedError(forKey: .entry, in: container, debugDescription: "Incomplete dictionary entry")
+            }
+            self = .englishWord(entry)
+        case "chineseWord":
+            let entries = try container.decode([SmartTranslationResult.Entry].self, forKey: .candidates)
+            guard entries.count == 2,
+                  entries.allSatisfy({ $0.isValid && !($0.usage ?? "").trimmingCharacters(in: .whitespacesAndNewlines).isEmpty }),
+                  Set(entries.map { $0.word.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() }).count == 2 else {
+                throw DecodingError.dataCorruptedError(forKey: .candidates, in: container, debugDescription: "Expected two distinct complete candidates")
+            }
+            self = .chineseWord(entries)
+        case "englishSentence":
+            let translation = try container.decode(String.self, forKey: .translation).trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !translation.isEmpty else {
+                throw DecodingError.dataCorruptedError(forKey: .translation, in: container, debugDescription: "Empty Chinese translation")
+            }
+            self = .englishSentence(translation)
+        case "chineseSentence": self = .chineseSentence
+        case "skip": self = .skip
+        default:
+            throw DecodingError.dataCorruptedError(forKey: .mode, in: container, debugDescription: "Unknown smart translation mode")
+        }
+    }
+
+    /// 仅接受完整 JSON 或完整 JSON 代码围栏，任何缺失字段均返回失败。
+    static func decode(_ response: String) -> Self? {
+        var json = response.trimmingCharacters(in: .whitespacesAndNewlines)
+        if json.hasPrefix("```") {
+            let lines = json.components(separatedBy: .newlines)
+            guard let first = lines.first?.lowercased(), first == "```json" || first == "```",
+                  lines.last == "```", lines.count >= 3 else { return nil }
+            json = lines.dropFirst().dropLast().joined(separator: "\n")
+        }
+        guard let data = json.data(using: .utf8) else { return nil }
+        return try? JSONDecoder().decode(Self.self, from: data)
+    }
+}
